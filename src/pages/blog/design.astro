---
import BaseLayout from "../../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL === "/" ? "" : import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
  title="Design | Ollie Olby"
  description='Design notes and future posts. Albert Einstein: "Everything should be made as simple as possible, but not simpler."'
>
  <section class="section-intro container">
    <h1>Design</h1>
    <p class="lede">
      Albert Einstein: "Everything should be made as simple as possible, but not simpler."
    </p>
  </section>

  <section class="container listing">
    <div class="listing-card listing-card-muted">
      <p>Nothing here yet.</p>
      <a class="text-link" href={`${base}/blog/`}>Back to blog index</a>
    </div>
  </section>
</BaseLayout>
