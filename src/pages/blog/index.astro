---
import BaseLayout from "../../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL === "/" ? "" : import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout title="Blog | Ollie Olby" description="Blog categories and project notes by Ollie Olby.">
  <section class="section-intro container">
    <h1>Writing</h1>
    <p class="lede">
      How I leverage linear algebra to solve simple problems.
    </p>
  </section>

  <section class="container blog-category-grid">
    <a class="blog-category-card" href={`${base}/blog/random/`}>
      <p class="blog-category-kicker">Blog</p>
      <h2>Random</h2>
      <p>I get bored from time to time</p>
    </a>

    <a class="blog-category-card" href={`${base}/blog/my-second-rodeo/`}>
      <p class="blog-category-kicker">Blog</p>
      <h2>My second rodeo</h2>
      <p>Just because it's my second rodeo does not mean I know what I am doing</p>
    </a>

    <a class="blog-category-card" href={`${base}/blog/design/`}>
      <p class="blog-category-kicker">Blog</p>
      <h2>Design</h2>
      <p>Albert Einstein: "Everything should be made as simple as possible, but not simpler."</p>
    </a>

    <a class="blog-category-card" href={`${base}/diary/`}>
      <p class="blog-category-kicker">Private</p>
      <h2>Observations</h2>
    </a>
  </section>
</BaseLayout>
