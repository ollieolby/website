---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL === "/" ? "" : import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
  title="Ollie Olby"
  description="Personal website, blog posts, and links to standalone apps by Ollie Olby."
>
  <section class="home-blank container" aria-label="Homepage">
    <div class="home-sketch" aria-hidden="true">
      <svg viewBox="0 0 1200 760" role="presentation">
        <g class="sketch sketch-one">
          <path d="M108 474C197 441 262 403 344 335C418 274 498 215 601 177" />
          <path d="M471 126L596 176L535 293" />
          <circle cx="344" cy="335" r="11" />
          <circle cx="596" cy="176" r="11" />
        </g>
        <g class="sketch sketch-two">
          <path d="M719 554C803 466 871 386 940 273C978 211 1004 165 1048 106" />
          <path d="M764 603L714 553L775 501" />
          <circle cx="940" cy="273" r="10" />
        </g>
        <g class="sketch sketch-three">
          <path d="M368 618H552C642 618 719 592 780 546C836 504 879 450 909 382" />
          <path d="M536 560L552 618L494 633" />
          <circle cx="780" cy="546" r="9" />
        </g>
        <g class="sketch sketch-four">
          <path d="M170 157H262L315 231H416" />
          <path d="M262 157L262 231" />
          <circle cx="170" cy="157" r="8" />
          <circle cx="416" cy="231" r="8" />
        </g>
      </svg>
    </div>

    <div class="home-copy">
      <p class="home-kicker">Ollie Olby</p>
      <h1>How I argue with linear algebra</h1>
      <p class="home-subtitle">Minimal site for personal writing and software projects.</p>
    </div>

    <div class="home-links" aria-label="Homepage sections">
      <a class="home-link-card" href={`${base}/blog/`}>
        <span class="home-link-label">Arguing</span>
        <span class="home-link-meta">Writing, notes, and blog posts</span>
      </a>
      <a class="home-link-card" href={`${base}/apps/`}>
        <span class="home-link-label">Designing</span>
        <span class="home-link-meta">Apps and software experiments</span>
      </a>
    </div>
  </section>
</BaseLayout>
