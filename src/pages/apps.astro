---
import BaseLayout from "../layouts/BaseLayout.astro";

const apps = [
  {
    name: "Becky",
    description: "A shared guide to Becky, Cormorant and Drakar, bringing boat systems, safety guidance, manuals and river information into one place.",
    liveUrl: "https://becky.ollieolby.co.uk/"
  },
  {
    name: "Chat",
    description: "A standalone chat app running on its own domain and linked from the main website.",
    liveUrl: "https://chat.ollieolby.co.uk/"
  },
  {
    name: "Anagnost",
    description: "A standalone interface project hosted separately and linked from the main website.",
    liveUrl: "https://ollieolby.github.io/anagnost-ui/"
  }
];
---

<BaseLayout title="Apps | Ollie Olby" description="A directory of standalone web apps by Ollie Olby.">
  <section class="section-intro container">
    <h1>Apps</h1>
    <p class="lede">
      A small set of standalone projects, each deployed separately and linked from here.
    </p>
  </section>

  <section class="container apps-grid">
    {apps.map((app) => (
      <article class="app-card">
        <p class="eyebrow">Live app</p>
        <h2><a href={app.liveUrl}>{app.name}</a></h2>
        <p>{app.description}</p>
        <a class="text-link" href={app.liveUrl}>Open app</a>
      </article>
    ))}
  </section>
</BaseLayout>
